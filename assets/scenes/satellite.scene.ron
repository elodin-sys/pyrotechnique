// LEO OreSat cinematic: craft at the origin, true-scale Earth 400 km below.
// Day/night is orbit phase (SkyRoot rotates once per 90 s). Capture times
// are lighting: t=0 noon, 22.5 dusk, 45 midnight, 67.5 dawn.
SceneConfig(
    model: ModelConfig(
        path: "models/oresat-low.glb",
        // Authored Y extent ~5.4 m (Elodin cube-sat scale). Keep normalize ≈ 1.
        target_height: 5.4,
    ),
    environment: EnvironmentConfig(
        sun_azimuth_deg: 25.0,
        sun_elevation_deg: 52.0,
        sun_illuminance: 100000.0,
        exposure_ev100: 13.5,
        bloom_intensity: 0.26,
        ground_radius: 0.0,
        ground_color: (0.0, 0.0, 0.0),
        atmosphere: true,
        camera_near: 0.08,
        camera_far: 20000000.0,
        earth: Some(EarthConfig(
            path: "models/earth.glb",
            altitude_m: 400000.0,
            radius_m: 6378140.0,
            rotation_deg: (30.0, 31.0, 0.0),
        )),
        atmosphere_inner_radius: Some(6378140.0),
        atmosphere_outer_radius: Some(6458140.0),
        atmosphere_raymarched: true,
        orbit_period_s: 90.0,
        earth_spin_deg_per_orbit: 20.0,
        night_exposure_ev100: Some(9.0),
        earthshine_illuminance: 2500.0,
        night_globe_illuminance: 180.0,
        ambient_brightness: 0.0,
    ),
    emitters: [
        EmitterConfig(
            name: "stars_dim",
            effect: "effects/satellite/stars_dim.effect",
            attach: "sky",
            position: (0.0, 0.0, 0.0),
            direction: (0.0, -1.0, 0.0),
            intensity: 1.0,
        ),
        EmitterConfig(
            name: "stars_bright",
            effect: "effects/satellite/stars_bright.effect",
            attach: "sky",
            position: (0.0, 0.0, 0.0),
            direction: (0.0, -1.0, 0.0),
            intensity: 1.0,
        ),
        EmitterConfig(
            name: "milky_way",
            effect: "effects/satellite/milky_way.effect",
            attach: "sky",
            position: (0.0, 0.0, 0.0),
            direction: (0.0, -1.0, 0.0),
            intensity: 1.0,
        ),
        EmitterConfig(
            name: "city_lights",
            effect: "effects/satellite/city_lights.effect",
            attach: "earth",
            position: (0.0, 0.0, 0.0),
            direction: (0.0, -1.0, 0.0),
            intensity: 1.0,
        ),
        EmitterConfig(
            name: "airglow_green",
            effect: "effects/satellite/airglow_green.effect",
            attach: "earth",
            position: (0.0, 0.0, 0.0),
            direction: (0.0, -1.0, 0.0),
            intensity: 1.0,
        ),
        EmitterConfig(
            name: "airglow_red",
            effect: "effects/satellite/airglow_red.effect",
            attach: "earth",
            position: (0.0, 0.0, 0.0),
            direction: (0.0, -1.0, 0.0),
            intensity: 1.0,
        ),
    ],
    flight: FlightConfig(
        align_to_velocity: false,
        keyframes: [
            FlightKey(t: 0.0, pos: (0.0, 0.0, 0.0)),
            FlightKey(t: 90.0, pos: (0.0, 0.0, 0.0)),
        ],
    ),
    cameras: [
        CameraPreset(
            name: "day-limb",
            pos: (7.0, 3.8, 10.5),
            look_at: (0.0, 2.2, 0.0),
            fov_deg: 55.0,
        ),
        CameraPreset(
            name: "day-look-down",
            pos: (3.2, 8.8, 6.2),
            look_at: (0.0, 1.0, 0.0),
            fov_deg: 62.0,
        ),
        CameraPreset(
            name: "dusk-terminator",
            pos: (5.0, 4.2, 12.0),
            look_at: (0.0, 1.4, -4.0),
            fov_deg: 52.0,
        ),
        CameraPreset(
            name: "night-limb",
            pos: (2.5, 4.2, 13.0),
            look_at: (0.0, 1.2, 2.0),
            fov_deg: 46.0,
        ),
        CameraPreset(
            name: "night-cities",
            pos: (7.0, 3.8, 10.5),
            look_at: (0.0, 2.2, 0.0),
            fov_deg: 55.0,
