// Apollo Lunar Module landing scene.
//
// Units: meters, seconds. Lander frame: base center at origin, +Y up (the GLB
// is auto-normalized to `target_height`). The Moon is airless: atmosphere is
// off (black sky), there is no drag, and the ground dust flies as a flat
// ballistic sheet instead of billowing.
//
// Timeline: powered descent from 120 m, braking to a vertical drop, engine
// cutoff at ~54 s, touchdown at 55 s. RCS quads pulse during the braking
// phases (t=18-20 and t=33-35).
SceneConfig(
    model: ModelConfig(
        path: "models/apollo-lunar-module.glb",
        // Metric contract with the Elodin sim: the LM GLB is modeled at ~5.0 m
        // and Elodin renders it raw (LANDER_GLB_SCALE = 1.0), so effects are
        // authored against the same 5.0 m craft. Do not change one side alone.
        target_height: 5.0,
    ),
    environment: EnvironmentConfig(
        sun_azimuth_deg: 320.0,
        sun_elevation_deg: 32.0,
        sun_illuminance: 130000.0,
        exposure_ev100: 13.2,
        bloom_intensity: 0.22,
        ground_radius: 20000.0,
        ground_color: (0.185, 0.18, 0.17),
        atmosphere: false,
    ),
    emitters: [
        EmitterConfig(
            name: "descent_engine",
            effect: "effects/apollo-lander/descent_plume.effect",
            // Inside the DPS bell, from GLB measurements: exit plane at
            // y=0.30, throat at y=1.01 in this normalized frame (Elodin KDL
            // object frame = this frame - 2.4; KDL uses y=-1.9).
            position: (0.0, 0.50, 0.0),
            direction: (0.0, -1.0, 0.0),
            intensity: 1.0,
            // Full throttle through the descent, cutoff just before the pads
            // touch (contact-probe shutdown).
            activity: [(0.0, 1.0), (52.0, 1.0), (54.5, 0.0)],
            // Plume light: anchors the plume to the bell on the shadow side
            // (additive particles emit no light) and pools on the ground
            // during the final meters. Warm white, throttle-tracked.
            light: Some(LightConfig(
                color: (1.0, 0.95, 0.88),
                intensity_lm: 3000000.0,
                range: 40.0,
                shadows: true,
                // Emitter is 0.2 m inside the bell; hang the light 0.6 m
                // below the exit so the bell interior is lit, not blasted.
                offset_m: 0.8,
            )),
        ),
        // Halo layer stacked on the same nozzle as descent_engine: the effect
        // file offsets its spawn volume below the exit plane itself.
        EmitterConfig(
            name: "descent_glow",
            effect: "effects/apollo-lander/descent_glow.effect",
            position: (0.0, 0.50, 0.0),
            direction: (0.0, -1.0, 0.0),
            intensity: 1.0,
            activity: [(0.0, 1.0), (52.0, 1.0), (54.5, 0.0)],
        ),
        EmitterConfig(
            name: "rcs_quad_px",
            effect: "effects/apollo-lander/rcs_puff.effect",
            position: (1.36, 3.86, 1.36),
            direction: (0.25, -1.0, 0.25),
            intensity: 1.0,
            activity: [(0.0, 0.0), (17.5, 0.0), (18.0, 1.0), (20.0, 1.0), (20.5, 0.0), (32.5, 0.0), (33.0, 1.0), (35.0, 1.0), (35.5, 0.0)],
        ),
        EmitterConfig(
            name: "rcs_quad_nx",
            effect: "effects/apollo-lander/rcs_puff.effect",
            position: (-1.36, 3.86, -1.36),
            direction: (-0.25, -1.0, -0.25),
            intensity: 1.0,
            activity: [(0.0, 0.0), (17.5, 0.0), (18.0, 1.0), (20.0, 1.0), (20.5, 0.0), (32.5, 0.0), (33.0, 1.0), (35.0, 1.0), (35.5, 0.0)],
        ),
        EmitterConfig(
            name: "rcs_quad_pz",
            effect: "effects/apollo-lander/rcs_puff.effect",
            position: (-1.36, 3.86, 1.36),
            direction: (-0.25, -1.0, 0.25),
            intensity: 1.0,
            activity: [(0.0, 0.0), (18.5, 0.0), (19.0, 1.0), (20.5, 1.0), (21.0, 0.0), (33.5, 0.0), (34.0, 1.0), (35.5, 1.0), (36.0, 0.0)],
        ),
        EmitterConfig(
            name: "rcs_quad_nz",
            effect: "effects/apollo-lander/rcs_puff.effect",
            position: (1.36, 3.86, -1.36),
            direction: (0.25, -1.0, -0.25),
            intensity: 1.0,
            activity: [(0.0, 0.0), (18.5, 0.0), (19.0, 1.0), (20.5, 1.0), (21.0, 0.0), (33.5, 0.0), (34.0, 1.0), (35.5, 1.0), (36.0, 0.0)],
        ),
        EmitterConfig(
            name: "ground_dust",
            effect: "effects/apollo-lander/ground_dust.effect",
            // World-fixed at the landing site: the dust sheet stays put as
            // the lander settles onto it.
            attach: "world",
            position: (0.0, 0.0, 0.0),
            direction: (0.0, -1.0, 0.0),
            intensity: 1.0,
            // Ramps in as the plume starts scouring the surface (~8 m alt),
            // peaks through touchdown, settles instantly after cutoff (no
            // air to keep grains aloft).
            activity: [(0.0, 0.0), (43.0, 0.0), (46.0, 0.12), (49.0, 0.6), (51.0, 1.0), (54.0, 1.0), (56.0, 0.1), (58.0, 0.0)],
        ),
    ],
    // Powered descent: braking approach from downrange, flattening into a
    // vertical drop and a gentle touchdown at t=55.
    flight: FlightConfig(
        keyframes: [
            FlightKey(t: 0.0, pos: (60.0, 120.0, 0.0)),
            FlightKey(t: 10.0, pos: (36.0, 78.0, 0.0)),
            FlightKey(t: 20.0, pos: (16.0, 44.0, 0.0)),
            FlightKey(t: 30.0, pos: (5.0, 22.0, 0.0)),
            FlightKey(t: 40.0, pos: (0.8, 9.0, 0.0)),
            FlightKey(t: 50.0, pos: (0.0, 2.5, 0.0)),
            FlightKey(t: 55.0, pos: (0.0, 0.0, 0.0)),
            FlightKey(t: 62.0, pos: (0.0, 0.0, 0.0)),
        ],
        // Landers stay upright; don't pitch the model along the velocity.
        align_to_velocity: false,
    ),
    cameras: [
        // Side profile riding with the lander: vehicle top-half, plume below.
        CameraPreset(
            name: "side_close",
            pos: (-5.7, 0.0, 9.3),
            look_at: (0.0, -0.36, 0.0),
            fov_deg: 42.0,
            track_rocket: true,
            follow_pos: true,
        ),
        // High chase looking down past the lander at the ground.
        CameraPreset(
            name: "top_profile",
            pos: (7.1, 9.3, 7.1),
            look_at: (0.0, -3.6, 0.0),
            fov_deg: 42.0,
            track_rocket: true,
            follow_pos: true,
        ),
        // Fixed near the landing site; pans with the craft as it settles.
        CameraPreset(
            name: "ground_wide",
            pos: (-18.6, 2.9, 21.4),
            look_at: (0.0, 1.43, 0.0),
            fov_deg: 32.0,
            track_rocket: true,
        ),
        // Tight on the RCS quads near the top deck.
        CameraPreset(
            name: "rcs_close",
            pos: (-4.6, 6.1, 6.1),
            look_at: (0.0, 3.7, 0.0),
            fov_deg: 30.0,
            track_rocket: true,
            follow_pos: true,
        ),
        // First Man main-engine framing: level with the DPS bell on its
        // shadow side, so the bell silhouettes dark against the plume column,
        // black sky behind.
        CameraPreset(
            name: "bell_close",
            // Long-lens look (movie): back + narrow fov compresses
            // perspective; bell silhouette in the top half of frame.
            pos: (-1.25, -0.05, -2.9),
            look_at: (0.0, 0.55, 0.0),
            fov_deg: 26.0,
            track_rocket: true,
            follow_pos: true,
        ),
        // side_close rotated 90 degrees in azimuth: A/B pair for checking the
        // plume reads the same from every side.
        CameraPreset(
            name: "side_90",
            pos: (9.3, 0.0, 5.7),
            look_at: (0.0, -0.36, 0.0),
            fov_deg: 42.0,
            track_rocket: true,
            follow_pos: true,
        ),
        // Side-below oblique (the "flat fan" report angle): close, slightly
        // under the descent stage, plume crossing the frame diagonally.
        CameraPreset(
            name: "bell_oblique",
            pos: (2.6, -1.4, 3.4),
            look_at: (0.0, 0.3, 0.0),
            fov_deg: 34.0,
            track_rocket: true,
            follow_pos: true,
        ),
        // F0 orbit ring (matches Elodin plume-orbit.kdl): R=12 m, slight
        // under-look so the plume column fills the frame. 45° steps in XZ.
        CameraPreset(
            name: "orbit_0",
            pos: (12.0, -0.5, 0.0),
            look_at: (0.0, -0.36, 0.0),
            fov_deg: 42.0,
            track_rocket: true,
            follow_pos: true,
        ),
        CameraPreset(
            name: "orbit_45",
            pos: (8.485, -0.5, 8.485),
            look_at: (0.0, -0.36, 0.0),
            fov_deg: 42.0,
            track_rocket: true,
            follow_pos: true,
        ),
        CameraPreset(
            name: "orbit_90",
            pos: (0.0, -0.5, 12.0),
            look_at: (0.0, -0.36, 0.0),
            fov_deg: 42.0,
            track_rocket: true,
            follow_pos: true,
        ),
        CameraPreset(
            name: "orbit_135",
            pos: (-8.485, -0.5, 8.485),
            look_at: (0.0, -0.36, 0.0),
            fov_deg: 42.0,
            track_rocket: true,
            follow_pos: true,
        ),
        CameraPreset(
            name: "orbit_180",
            pos: (-12.0, -0.5, 0.0),
            look_at: (0.0, -0.36, 0.0),
            fov_deg: 42.0,
            track_rocket: true,
            follow_pos: true,
        ),
        CameraPreset(
            name: "orbit_225",
            pos: (-8.485, -0.5, -8.485),
            look_at: (0.0, -0.36, 0.0),
            fov_deg: 42.0,
            track_rocket: true,
            follow_pos: true,
        ),
        CameraPreset(
            name: "orbit_270",
            pos: (0.0, -0.5, -12.0),
            look_at: (0.0, -0.36, 0.0),
            fov_deg: 42.0,
            track_rocket: true,
            follow_pos: true,
        ),
        CameraPreset(
            name: "orbit_315",
            pos: (8.485, -0.5, -8.485),
            look_at: (0.0, -0.36, 0.0),
            fov_deg: 42.0,
            track_rocket: true,
            follow_pos: true,
        ),
    ],
    scenarios: [
        ScenarioConfig(
            name: "plume-side",
            camera: "side_close",
            capture_time: 30.0,
            reference: Some("targets/apollo-lander/sim-landing-main-thruster-plume-side-profile.png"),
        ),
        ScenarioConfig(
            name: "plume-closeup",
            camera: "bell_close",
            capture_time: 30.0,
            reference: Some("targets/apollo-lander/firstman-movie-main-thruster-fire-close-up.png"),
        ),
        ScenarioConfig(
            name: "plume-side-90",
            camera: "side_90",
            capture_time: 30.0,
            reference: Some("targets/apollo-lander/sim-landing-main-thruster-plume-side-profile.png"),
        ),
        ScenarioConfig(
            name: "plume-oblique",
            camera: "bell_oblique",
            capture_time: 30.0,
            reference: Some("targets/apollo-lander/firstman-movie-main-thruster-fire-close-up.png"),
        ),
        // F0 azimuth sweep (t=30, lander ~22 m up — off-origin enough to
        // stress Local-space FaceCamera). Capture all eight:
        //   for s in plume-orbit-{0,45,90,135,180,225,270,315}; do
        //     cargo run -q -- capture --project apollo-lander --scenario $s; done
        ScenarioConfig(
            name: "plume-orbit-0",
            camera: "orbit_0",
            capture_time: 30.0,
        ),
        ScenarioConfig(
            name: "plume-orbit-45",
            camera: "orbit_45",
            capture_time: 30.0,
        ),
        ScenarioConfig(
            name: "plume-orbit-90",
            camera: "orbit_90",
            capture_time: 30.0,
        ),
        ScenarioConfig(
            name: "plume-orbit-135",
            camera: "orbit_135",
            capture_time: 30.0,
        ),
        ScenarioConfig(
            name: "plume-orbit-180",
            camera: "orbit_180",
            capture_time: 30.0,
        ),
        ScenarioConfig(
            name: "plume-orbit-225",
            camera: "orbit_225",
            capture_time: 30.0,
        ),
        ScenarioConfig(
            name: "plume-orbit-270",
            camera: "orbit_270",
            capture_time: 30.0,
        ),
        ScenarioConfig(
            name: "plume-orbit-315",
            camera: "orbit_315",
            capture_time: 30.0,
        ),
        ScenarioConfig(
            name: "plume-top",
            camera: "top_profile",
            capture_time: 44.0,
            reference: Some("targets/apollo-lander/sim-landing-main-thruster-plume-top-profile.png"),
        ),
        ScenarioConfig(
            name: "rcs-far",
            camera: "ground_wide",
            capture_time: 34.0,
            reference: Some("targets/apollo-lander/firstman-movie-rcs-thruster-fire-far.png"),
            // The movie frame is nearly a silhouette; stop down.
            exposure_ev100: Some(14.2),
        ),
        ScenarioConfig(
            name: "rcs-close",
            camera: "rcs_close",
            capture_time: 34.5,
            reference: Some("targets/apollo-lander/firstman-movie-rcs-thruster-fire-close-up.png"),
        ),
        ScenarioConfig(
            name: "ground-effect",
            camera: "ground_wide",
            capture_time: 50.0,
            reference: Some("targets/apollo-lander/sim-ground-effect-close.png"),
        ),
        ScenarioConfig(
            name: "touchdown",
            camera: "ground_wide",
            capture_time: 54.0,
            reference: Some("targets/apollo-lander/sim-ground-effect-closest-1.png"),
        ),
    ],
)
